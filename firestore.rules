rules_version = '2';
// Regras do Provador.
// Princípio: o dono da plataforma (papel "plataforma") lê e escreve o que é dele;
// o público só LÊ um documento por vez do que a vitrine precisa para abrir (nada financeiro);
// o público só CRIA pedido de loja, com campos e tamanhos conferidos aqui;
// a lojista que monta a loja sozinha cria a loja dela UMA vez (15 dias grátis) e depois só mexe
// nos dados da vitrine e nas peças. Status, cobrança, plano e prazo do teste são da plataforma.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    // papel pelo UID ou pelo e-mail verificado (o dono pode ser liberado antes do primeiro login)
    function emailVerificado() {
      return 'email' in request.auth.token && request.auth.token.email_verified == true;
    }
    function papelPorUid() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && 'plataforma' in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papeis;
    }
    function papelPorEmail() {
      return emailVerificado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
        && 'plataforma' in get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.papeis;
    }
    function plataforma() { return logado() && (papelPorUid() || papelPorEmail()); }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function dono(id) { return logado() && request.auth.uid == id; }
    function slugOk(v) { return v is string && v.matches('^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$'); }
    function digitos(v, max) { return v is string && v.matches('^[0-9]*$') && v.size() <= max; }
    // prazo do teste: 15 dias a partir de agora (folga de um dia para o relógio do celular)
    function testeOk(d) {
      return d.trialAteTs is timestamp
        && d.trialAteTs > request.time + duration.value(14, 'd')
        && d.trialAteTs < request.time + duration.value(16, 'd')
        && d.trialAte is string && d.trialAte.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // marcas @@...@@ que a vitrine usa
    function marcaOk(m) {
      return m is map
        && m.keys().hasOnly(['NOME', 'MARCA', 'MARCA_SUB', 'IG', 'CIDADE', 'CIDADE_CURTA', 'WHATS', 'INICIAIS'])
        && texto(m.get('NOME', ''), 0, 80) && texto(m.get('MARCA', ''), 0, 80) && texto(m.get('MARCA_SUB', ''), 0, 80)
        && texto(m.get('IG', ''), 0, 40) && texto(m.get('CIDADE', ''), 0, 80) && texto(m.get('CIDADE_CURTA', ''), 0, 80)
        && digitos(m.get('WHATS', ''), 13) && texto(m.get('INICIAIS', ''), 0, 4);
    }
    // loja nova criada pelo montador: só os campos de criação, status "teste", prazo certo e o endereço público já reservado no mesmo lote
    function lojaNovaOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'nome', 'marcaCurta', 'marcaSub', 'cidade', 'instagram', 'whatsappLoja', 'vitrine', 'plano', 'status', 'origem',
          'trialAte', 'trialAteTs', 'criadaEm', 'dono', 'checklist', 'slug'])
        && d.id == id && d.status == 'teste' && d.origem == 'montador'
        && texto(d.nome, 1, 80) && texto(d.marcaCurta, 0, 24) && texto(d.marcaSub, 0, 30) && texto(d.cidade, 0, 60)
        && texto(d.instagram, 0, 40) && digitos(d.whatsappLoja, 13)
        && slugOk(d.vitrine) && slugOk(d.slug) && d.plano in ['vitrine', 'loja', 'completo'] && testeOk(d)
        && texto(d.criadaEm, 10, 10)
        && d.dono is map && d.dono.keys().hasOnly(['uid', 'nome', 'email', 'celular']) && d.dono.uid == id
        && texto(d.dono.nome, 0, 80) && texto(d.dono.email, 0, 120) && digitos(d.dono.celular, 13)
        && d.checklist is map && d.checklist.keys().hasOnly(['logo', 'fotos', 'produtos', 'pagamento', 'dominio'])
        && d.checklist.pagamento == false && d.checklist.dominio == false
        && getAfter(/databases/$(database)/documents/lojasPublicas/$(d.slug)).data.lojaId == id;
    }
    // o que a lojista pode mudar na loja dela depois de publicada
    function lojaEdicaoOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['nome', 'marcaCurta', 'marcaSub', 'cidade', 'instagram', 'whatsappLoja', 'vitrine', 'dominioPedido', 'vipCodigo'])
        && (!('vipCodigo' in d) || (d.vipCodigo is string && d.vipCodigo.matches('^[A-Za-z0-9]{12,40}$')))
        && texto(d.nome, 1, 80) && texto(d.get('marcaCurta', ''), 0, 80) && texto(d.get('marcaSub', ''), 0, 80)
        && texto(d.get('cidade', ''), 0, 80) && texto(d.get('instagram', ''), 0, 40) && digitos(d.get('whatsappLoja', ''), 13)
        && slugOk(d.vitrine) && texto(d.get('dominioPedido', ''), 0, 120);
    }
    // a plataforma grava o endereço público com os campos de sempre
    function publicaPelaPlataforma(slug) {
      return plataforma()
        && request.resource.data.keys().hasOnly(['slug', 'vitrine', 'status', 'dominio', 'marca', 'lojaId', 'trialAte', 'trialAteTs', 'vipHash'])
        && request.resource.data.slug == slug;
    }
    function lojaViva(id) {
      return exists(/databases/$(database)/documents/lojas/$(id))
        && get(/databases/$(database)/documents/lojas/$(id)).data.status in ['teste', 'ativa', 'pausada'];
    }
    // foto: data URL de imagem já comprimida pelo montador, ou endereço https
    function imgOk(v) {
      return v is string && v.size() > 30 && v.size() < 400000
        && (v.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+') || v.matches('https://[^\\s"<>]+'));
    }
    function itemOk(itemId) {
      let d = request.resource.data;
      return itemId.matches('^[A-Za-z0-9_-]{1,40}$')
        && d.keys().hasOnly(['nome', 'cat', 'cor', 'hex', 'preco', 'tamanhos', 'img', 'img2', 'novo', 'ordem', 'descricao', 'estoque', 'sku', 'vipAte'])
        && texto(d.nome, 1, 80)
        && d.cat in ['conjuntos', 'leggings', 'tops', 'macacoes', 'macaquinhos', 'acessorios']
        && texto(d.get('cor', ''), 0, 30)
        && (!('hex' in d) || (d.hex is string && d.hex.matches('^#[0-9A-Fa-f]{6}$')))
        && d.preco is number && d.preco >= 0 && d.preco <= 100000
        && d.tamanhos is list && d.tamanhos.size() <= 5 && d.tamanhos.hasOnly(['P', 'M', 'G', 'GG', 'U'])
        && imgOk(d.img) && (!('img2' in d) || imgOk(d.img2))
        && d.novo is bool && d.ordem is number
        && texto(d.get('descricao', ''), 0, 600)
        && estoqueOk(d)
        && (!('sku' in d) || (d.sku is string && d.sku.matches('^[A-Z0-9-]{1,24}$')))
        && (!('vipAte' in d) || (d.vipAte is string && d.vipAte.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')));
    }
    function qtdOk(e, t) { return !(t in e) || (e[t] is int && e[t] >= 0 && e[t] <= 9999); }
    // estoque por tamanho: { P: 3, M: 0 } (inteiros de 0 a 9999)
    function estoqueOk(d) {
      return !('estoque' in d) || (d.estoque is map && d.estoque.keys().hasOnly(['P', 'M', 'G', 'GG', 'U'])
        && qtdOk(d.estoque, 'P') && qtdOk(d.estoque, 'M') && qtdOk(d.estoque, 'G') && qtdOk(d.estoque, 'GG') && qtdOk(d.estoque, 'U'));
    }
    // contato da cliente da loja (lista VIP e aviso de reposição)
    function contatoOk(d) {
      return texto(d.nome, 2, 60) && d.whats is string && d.whats.matches('^[0-9]{10,13}$') && d.criadoEm == request.time;
    }

    // papéis: só leitura do próprio documento; quem dá papel é o console/Admin SDK
    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || (emailVerificado() && request.auth.token.email == uid));
      allow list, write: if false;
    }

    // cadastro completo das lojas: dinheiro, dono, cobrança. A dona lê a dela, cria uma vez e edita só a vitrine.
    match /lojas/{id} {
      allow get: if dono(id) || plataforma();
      allow list, delete: if plataforma();
      allow create: if (dono(id) && lojaNovaOk(id)) || plataforma();
      allow update: if (dono(id) && lojaEdicaoOk()) || plataforma();
    }

    // peças de cada loja (a vitrine lê; a dona ou a plataforma escrevem)
    match /catalogos/{lojaId}/itens/{itemId} {
      allow read: if true;
      allow create, update: if ((dono(lojaId) && lojaViva(lojaId)) || plataforma()) && itemOk(itemId);
      allow delete: if dono(lojaId) || plataforma();
    }

    // o mínimo para a vitrine abrir pelo link ou pelo domínio (um por vez; sem listar)
    match /lojasPublicas/{slug} {
      allow get: if true;
      allow list: if false;
      // a lojista reserva o endereço junto com a criação da loja (mesmo lote), e só se ainda não tinha loja
      allow create: if (dono(request.resource.data.lojaId)
          && request.resource.data.keys().hasOnly(['slug', 'vitrine', 'status', 'dominio', 'marca', 'lojaId', 'trialAte', 'trialAteTs'])
          && request.resource.data.slug == slug && slugOk(slug)
          && request.resource.data.status == 'teste' && request.resource.data.dominio == ''
          && slugOk(request.resource.data.vitrine) && marcaOk(request.resource.data.marca) && testeOk(request.resource.data)
          && !exists(/databases/$(database)/documents/lojas/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/lojas/$(request.auth.uid)).data.slug == slug)
        || publicaPelaPlataforma(slug);
      allow update: if (dono(resource.data.get('lojaId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vitrine', 'marca', 'vipHash'])
          && slugOk(request.resource.data.vitrine) && marcaOk(request.resource.data.marca)
          && (!('vipHash' in request.resource.data) || (request.resource.data.vipHash is string && request.resource.data.vipHash.matches('^[0-9a-f]{64}$'))))
        || publicaPelaPlataforma(slug);
      allow delete: if plataforma();
    }
    match /dominios/{host} {
      allow get: if true;
      allow list: if false;
      allow create, update: if plataforma() && request.resource.data.keys().hasOnly(['slug']);
      allow delete: if plataforma();
    }
    match /site/planos {
      allow get: if true;
      allow write: if plataforma();
    }

    // pedidos de loja do site de vendas
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'loja', 'instagram', 'whatsapp', 'vitrine', 'plano', 'mensagem', 'status', 'criadoEm'])
        && texto(request.resource.data.nome, 2, 80)
        && texto(request.resource.data.loja, 2, 80)
        && texto(request.resource.data.instagram, 0, 40)
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
        && texto(request.resource.data.vitrine, 0, 40)
        && request.resource.data.plano in ['vitrine', 'loja', 'completo']
        && texto(request.resource.data.mensagem, 0, 500)
        && request.resource.data.status == 'novo'
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if plataforma();
      allow update: if plataforma() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'nota']);
    }

    // dinheiro da plataforma
    match /contasPagar/{id} { allow read, write: if plataforma(); }
    match /financeiroPlataforma/{doc} {
      allow read: if plataforma();
      // resumo e histórico são do servidor; o painel só grava a tabela de preços
      allow write: if plataforma() && doc == 'precos';
    }

    // números agregados que alimentam o resumo (escritos pelo servidor)
    match /vendasMes/{id} { allow read: if plataforma(); allow write: if false; }
    match /usoIA/{dia} { allow read: if plataforma(); allow write: if false; }

    // "Atualizar números": o painel cria o pedido; a função responde
    match /comandos/{id} {
      allow create: if plataforma()
        && request.resource.data.keys().hasOnly(['tipo', 'porUid', 'status', 'criadoEm'])
        && request.resource.data.tipo == 'resumoPlataforma'
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow get: if plataforma() && resource.data.porUid == request.auth.uid;
      allow list, update, delete: if false;
    }

    // trilha de auditoria: só acrescenta, ninguém edita nem apaga
    match /auditoria/{id} {
      allow read: if plataforma();
      allow create: if plataforma() && request.resource.data.keys().hasOnly(['quando', 'quem', 'oque', 'colecao', 'alvo']);
      allow update, delete: if false;
    }

    // gestão da loja (vendas, caixa, contas, movimentos de estoque, clientes): só a dona ou a plataforma
    match /gestao/{lojaId}/{colecao}/{id} {
      allow read: if dono(lojaId) || plataforma();
      allow create, update: if ((dono(lojaId) && lojaViva(lojaId)) || plataforma())
        && colecao in ['vendas', 'caixa', 'contas', 'movimentos', 'clientes']
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.keys().size() <= 24;
      allow delete: if dono(lojaId) || plataforma();
    }

    // lista VIP da loja: a cliente só se inscreve; a dona lê e apaga
    match /vip/{lojaId}/contatos/{id} {
      allow create: if lojaViva(lojaId) && request.resource.data.keys().hasOnly(['nome', 'whats', 'criadoEm']) && contatoOk(request.resource.data);
      allow read, delete: if dono(lojaId) || plataforma();
      allow update: if false;
    }

    // "avise-me quando chegar": a cliente só cria; a dona lê, marca como avisado e apaga
    match /avisos/{lojaId}/pedidos/{id} {
      allow create: if lojaViva(lojaId)
        && request.resource.data.keys().hasOnly(['nome', 'whats', 'itemId', 'peca', 'tam', 'criadoEm', 'avisado'])
        && contatoOk(request.resource.data)
        && request.resource.data.itemId is string && request.resource.data.itemId.matches('^[A-Za-z0-9_-]{1,40}$')
        && texto(request.resource.data.peca, 1, 80)
        && request.resource.data.tam in ['P', 'M', 'G', 'GG', 'U']
        && request.resource.data.avisado == false;
      allow read, delete: if dono(lojaId) || plataforma();
      allow update: if dono(lojaId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisado'])
        && request.resource.data.avisado is bool;
    }

    // acompanhamento do pedido: a cliente abre pelo link com o token (um documento por vez); só a dona grava
    match /acompanhar/{token} {
      allow get: if token.matches('^[A-Za-z0-9]{20,40}$');
      allow list: if false;
      allow create, update: if token.matches('^[A-Za-z0-9]{20,40}$')
        && dono(request.resource.data.lojaId)
        && (resource == null || resource.data.lojaId == request.resource.data.lojaId)
        && request.resource.data.keys().hasOnly(['lojaId', 'slug', 'loja', 'numero', 'status', 'itens', 'atualizadoEm'])
        && request.resource.data.status in ['pago', 'separado', 'enviado', 'entregue', 'cancelado']
        && texto(request.resource.data.slug, 0, 40) && texto(request.resource.data.loja, 0, 80)
        && texto(request.resource.data.numero, 0, 12) && texto(request.resource.data.atualizadoEm, 0, 30)
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 30;
      allow delete: if dono(resource.data.lojaId);
    }

    // canais de venda (Meta, Google e hubs): a dona liga e configura; leitura pública porque o workflow
    // que publica os arquivos dos canais lê daqui (só dados de catálogo, nada financeiro nem de clientes)
    function medidaOk(v, min, max) { return v is int && v >= min && v <= max; }
    function canaisOk(d) {
      return d.keys().hasOnly(['lojaId', 'slug', 'ativo', 'marca', 'genero', 'idade', 'catRoupas', 'catAcess',
          'pesoG', 'comprimentoCm', 'larguraCm', 'alturaCm', 'ncm', 'atualizadoEm'])
        && d.ativo is bool && texto(d.marca, 0, 80)
        && d.genero in ['female', 'male', 'unisex'] && d.idade in ['adult', 'teen', 'kids']
        && d.catRoupas in ['5322', '1604', '167', '166'] && d.catAcess in ['5322', '1604', '167', '166']
        && medidaOk(d.pesoG, 10, 30000) && medidaOk(d.comprimentoCm, 1, 200) && medidaOk(d.larguraCm, 1, 200) && medidaOk(d.alturaCm, 1, 200)
        && d.ncm is string && d.ncm.matches('^([0-9]{8})?$') && texto(d.atualizadoEm, 0, 30);
    }
    match /canaisAtivos/{slug} {
      allow read: if true;
      allow create, update: if slugOk(slug)
        && dono(request.resource.data.lojaId)
        && request.resource.data.slug == slug
        && (resource == null || resource.data.lojaId == request.resource.data.lojaId)
        && get(/databases/$(database)/documents/lojasPublicas/$(slug)).data.lojaId == request.resource.data.lojaId
        && canaisOk(request.resource.data);
      allow delete: if dono(resource.data.lojaId) || plataforma();
    }

    match /{caminho=**} { allow read, write: if false; }
  }
}
