{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "test"],
      "predeploy": [
        "node -e \"const p=require('path'),f=require('fs');f.copyFileSync(p.join(process.env.PROJECT_DIR,'shared','calc.js'),p.join(process.env.RESOURCE_DIR,'calc.js'))\""
      ]
    }
  ],
  "hosting": [
    {
      "target": "plataforma",
      "public": ".",
      "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "functions/**", "tools/**", "tests/**", "*.md", "*.rules", "firestore.indexes.json"],
      "headers": [
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-eval' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://www.gstatic.com https://dns.google; frame-src 'self' https://*.firebaseapp.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" }
        ] },
        { "source": "painel/**", "headers": [ { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-cache" } ] },
        { "source": "**/*.@(woff|woff2|jpg|png)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
        { "source": "**/*.@(js|css|html|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
      ]
    },
    {
      "target": "lojas",
      "public": ".",
      "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "functions/**", "tools/**", "tests/**", "*.md", "*.rules", "firestore.indexes.json", "index.html", "painel/**"],
      "rewrites": [ { "source": "**", "destination": "/vitrine.html" } ],
      "headers": [
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-eval' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
        ] },
        { "source": "**/*.@(woff|woff2|jpg|png)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
        { "source": "**/*.@(js|css|html|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
      ]
    }
  ]
}
