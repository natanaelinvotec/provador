rules_version = '2';
// Fotos e logos das lojas: leitura pública (aparecem na vitrine), escrita só da plataforma.
service firebase.storage {
  match /b/{bucket}/o {
    match /lojas/{lojaId}/{arquivo=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && 'plataforma' in firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.papeis
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{tudo=**} { allow read, write: if false; }
  }
}
